---
import { NAV_LINKS, WHATSAPP_URL } from '../consts';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Joaquín López — inicio">Joaquin</a>

    <nav class="site-nav" id="site-menu" aria-label="Navegación principal">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            link.href === currentPath || (link.href !== '/' && currentPath.startsWith(link.href));
          const isContacto = link.href === '/#contacto';
          return (
            <a
              href={link.href}
              class:list={['site-nav__link', isContacto && 'site-nav__link--contacto']}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <a class="btn btn--primary site-nav__cta" href={WHATSAPP_URL} target="_blank" rel="noopener">
        WhatsApp
      </a>

      <div class="site-nav__theme">
        <span class="site-nav__theme-label">Modo</span>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          role="switch"
          aria-checked="false"
          aria-label="Cambiar a tema claro"
        >
          <span class="theme-toggle__thumb" aria-hidden="true">
            <svg
              class="theme-toggle__icon theme-toggle__icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="theme-toggle__icon theme-toggle__icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
              ></path>
            </svg>
          </span>
        </button>
      </div>
    </nav>

    <div class="site-header__side">
      <a class="btn btn--primary site-header__cta" href="/#contacto">Contacto</a>

      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        role="switch"
        aria-checked="false"
        aria-label="Cambiar a tema claro"
      >
        <span class="theme-toggle__thumb" aria-hidden="true">
          <svg
            class="theme-toggle__icon theme-toggle__icon--moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="theme-toggle__icon theme-toggle__icon--sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
          </svg>
        </span>
      </button>

      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Abrir menú"
      >
        <span class="nav-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-checked', String(theme === 'dark'));
      toggle.setAttribute(
        'aria-label',
        theme === 'light' ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro'
      );
    });
  };

  applyTheme((root.dataset.theme as 'light' | 'dark') ?? 'dark');

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      applyTheme(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* almacenamiento no disponible */
      }
    });
  });

  const media = window.matchMedia('(prefers-color-scheme: light)');
  media.addEventListener('change', (e) => {
    try {
      if (localStorage.getItem('theme')) return;
    } catch {
      /* almacenamiento no disponible */
    }
    applyTheme(e.matches ? 'light' : 'dark');
  });

  const navToggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-menu');

  const setNavOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
    navToggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  navToggle?.addEventListener('click', () => {
    setNavOpen(navToggle.getAttribute('aria-expanded') !== 'true');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('click', (e) => {
    if (navToggle?.getAttribute('aria-expanded') !== 'true') return;
    const target = e.target as Node;
    if (nav?.contains(target) || navToggle?.contains(target)) return;
    setNavOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setNavOpen(false);
  });

  const header = document.querySelector('.site-header');
  let isScrolled = false;
  const setScrolled = () => {
    const next = window.scrollY > 24;
    if (next === isScrolled) return;
    isScrolled = next;
    header?.classList.toggle('site-header--scrolled', next);
  };

  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });
</script>
