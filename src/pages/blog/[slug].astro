---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Artwork from '../../components/Artwork.astro';
import { blogArt } from '../../data/art';
import { SITE_URL, WHATSAPP_URL, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@id': `${SITE_URL}/#person`, name: post.data.author },
  publisher: { '@id': `${SITE_URL}/#person` },
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
  inLanguage: 'es-AR',
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={post.data.description}
  type="article"
  image={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  jsonLd={articleJsonLd}
>
  <article class="section">
    <div class="container">
      <header style="max-width: 46rem; margin-bottom: 2.5rem;">
        <p class="post-card__meta">
          <a href="/blog">← Blog</a> · {formatDate(post.data.pubDate)}
        </p>
        <h1 class="section__title" style="margin-top: 0.75rem;">{post.data.title}</h1>
        <p class="section__lead">{post.data.description}</p>
      </header>

      <div class="post-cover">
        <Artwork variant={blogArt(post.id)} />
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="value-banner" style="margin-top: 3.5rem;">
        <div>
          <h2 class="value-banner__title">¿Querés una web así para tu negocio?</h2>
          <p class="value-banner__text">
            Te paso un presupuesto claro y sin cargo en el día. Contame qué necesitás.
          </p>
        </div>
        <a class="btn btn--primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
          Pedir presupuesto
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
