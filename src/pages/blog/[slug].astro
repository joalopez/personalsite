---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Artwork from '../../components/Artwork.astro';
import { blogArt } from '../../data/art';
import { SITE_URL, WHATSAPP_URL, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });

const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const relatedPosts = allPosts
  .filter((entry) => entry.id !== post.id)
  .map((entry) => ({
    post: entry,
    shared: entry.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .sort(
    (a, b) =>
      b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 2)
  .map((entry) => entry.post);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@id': `${SITE_URL}/#person`, name: post.data.author },
  publisher: { '@id': `${SITE_URL}/#person` },
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
  inLanguage: 'es-AR',
  keywords: post.data.tags.join(', '),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: `${SITE_URL}/blog/${post.id}`,
    },
  ],
};

const faqJsonLd = post.data.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
      })),
    }
  : null;

const jsonLd = [articleJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<BaseLayout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={post.data.description}
  type="article"
  image={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container">
      <header style="max-width: 46rem; margin-bottom: 2.5rem;">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">›</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
        <h1 class="section__title" style="margin-top: 0.75rem;">{post.data.title}</h1>
        <p class="section__lead">{post.data.description}</p>
        <p class="post-card__meta" style="margin-top: 0.75rem;">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {' · '}{readingTime} min de lectura
        </p>
      </header>

      <div class="post-cover">
        <Artwork variant={blogArt(post.id)} />
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        post.data.faqs.length > 0 && (
          <section class="post-faq" aria-labelledby="faq-post-title" style="margin-top: 3.5rem;">
            <span class="section__eyebrow">Preguntas frecuentes</span>
            <h2
              class="section__title"
              id="faq-post-title"
              style="font-size: clamp(1.4rem, 3.5vw, 2rem);"
            >
              Dudas sobre este tema
            </h2>
            <div class="faq" style="margin-top: 1.5rem;">
              {post.data.faqs.map((faq) => (
                <details name="faq-post">
                  <summary>{faq.pregunta}</summary>
                  <p>{faq.respuesta}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <div class="value-banner" style="margin-top: 3.5rem;">
        <div>
          <h2 class="value-banner__title">¿Querés una web así para tu negocio?</h2>
          <p class="value-banner__text">
            Te paso un presupuesto claro y sin cargo en el día. Contame qué necesitás.
          </p>
        </div>
        <a class="btn btn--primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
          Pedir presupuesto
        </a>
      </div>

      {
        relatedPosts.length > 0 && (
          <section class="post-related" aria-labelledby="related-title" style="margin-top: 3.5rem;">
            <span class="section__eyebrow">Seguí leyendo</span>
            <h2
              class="section__title"
              id="related-title"
              style="font-size: clamp(1.4rem, 3.5vw, 2rem);"
            >
              Artículos relacionados
            </h2>
            <div class="post-list" style="margin-top: 1.5rem;">
              {relatedPosts.map((related) => (
                <article class="post-card">
                  <div class="post-card__cover">
                    <Artwork variant={blogArt(related.id)} />
                  </div>
                  <div class="post-card__body">
                    <p class="post-card__meta">{formatDate(related.data.pubDate)}</p>
                    <h3 class="post-card__title">
                      <a href={`/blog/${related.id}`}>{related.data.title}</a>
                    </h3>
                    <p class="post-card__text">{related.data.description}</p>
                    <a class="card__link" href={`/blog/${related.id}`}>Leer artículo</a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
